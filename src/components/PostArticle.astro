---
// Full post view: title, byline, content slot, action links.
import { MASTODON_URL, REPO_URL } from '../lib/site';
import { readMinutes } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const tags = post.data.tags ?? [];
---

<article>
  <header class="article-head">
    <PostMeta
      pubDate={post.data.pubDate}
      minutes={readMinutes(post.body ?? '')}
      updated={post.data.updated}
    />
    <div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <hr class="rule" />
    </div>
  </header>
  <div class="article-body">
    <div aria-hidden="true"></div>
    <div class="prose">
      <slot />
    </div>
  </div>
  <div class="article-foot">
    <div aria-hidden="true"></div>
    <div class="inner">
      <div>filed under {tags.join(' · ')}</div>
      <div class="endlinks">
        <a class="btn" href={MASTODON_URL}>Discuss on Mastodon</a>
        <a class="btn" href={`${REPO_URL}/issues`}>Report an issue</a>
        <a class="btn" href={REPO_URL}>Edit on GitHub</a>
      </div>
    </div>
  </div>
</article>
