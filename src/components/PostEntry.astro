---
// Port of _includes/post.html (+ minutes.html + updated.html), used both as
// the homepage card (excerpt mode) and the post page renderer (full mode).
import { marked } from 'marked';
import { formatDateString } from '../lib/dates';
import { MASTODON_URL, REPO_URL } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  full?: boolean;
}

const { post, full = false } = Astro.props;

const body: string = post.body ?? '';
const raw = body.includes('<!--more-->') ? body.split('<!--more-->')[0] : body.split(/\n\n+/)[0];
const excerptHtml = full ? null : (marked.parse(raw) as string);

// minutes.html: (words >= 250) ? floor(words / 180) : none
const words = body.trim().split(/\s+/).length;
const minutes = words >= 250 ? Math.floor(words / 180) : null;

const href = `/${post.id}/`;
const hasExcerpt = !full;
---

{
  hasExcerpt ? (
    <article class="card">
      <h2>
        <a href={href}>{post.data.title}</a>
      </h2>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString().split('T')[0]}>
          {formatDateString(post.data.pubDate)}
        </time>
        {minutes && <span class="pill">{minutes} min read</span>}
        {post.data.updated && (
          <span class="pill pill--ghost">Updated: {formatDateString(post.data.updated)}</span>
        )}
      </p>
      <div class="excerpt">
        <Fragment set:html={excerptHtml} />
      </div>
      <a class="more" href={href}>
        Read the rest&hellip;
      </a>
    </article>
  ) : (
    <article>
      <header class="article-header">
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString().split('T')[0]}>
            {formatDateString(post.data.pubDate)}
          </time>
          {minutes && <span class="pill">{minutes} min read</span>}
          {post.data.updated && (
            <span class="pill pill--ghost">Updated: {formatDateString(post.data.updated)}</span>
          )}
        </p>
      </header>
      <slot />
      <div class="endlinks">
        <a class="btn" href={MASTODON_URL}>
          Discuss on Mastodon
        </a>
        <a class="btn" href={`${REPO_URL}/issues`}>
          Report an issue
        </a>
        <a class="btn" href={`${REPO_URL}`}>
          Edit on GitHub
        </a>
      </div>
    </article>
  )
}
