---
// Shared gutter metadata for the article view: dotted date, revision,
// read time. Renders as the stacked mono column left of the title.
import { formatDotted, laIso } from '../lib/dates';

interface Props {
  pubDate: Date;
  minutes?: number | null;
  updated?: Date;
}

const { pubDate, minutes = null, updated } = Astro.props;
---

<p class="gutter-meta">
  <time datetime={laIso(pubDate)}>{formatDotted(pubDate)}</time>
  {updated && <span>rev {formatDotted(updated)}</span>}
  {minutes && <span>{minutes} min read</span>}
</p>
