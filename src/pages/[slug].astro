---
// Port of the `/:title/` permalink: slug = collection id = filename slug
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostArticle from '../components/PostArticle.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Preload exactly the variable fonts a page's rendered content needs, so the
// head links stay truthful (a preloaded-but-unused font is a console warning
// and wasted bytes). Fenced code first (indented code doesn't occur in this
// corpus), blockquote lines after stripping those fences — a `>` inside a
// code sample must not preload the serif-italic face.
const markdownWithoutFences = (post.body ?? '').replace(/^```[^\n]*$[\s\S]*?^```$/gm, '');
const preloadMono = (post.body ?? '').includes('```');
const preloadSerifItalic = /^\s*>/m.test(markdownWithoutFences);
---

<Base
  pageTitle={post.data.title}
  description={post.data.description}
  path={`/${post.id}/`}
  type="article"
  pubDate={post.data.pubDate}
  preloadMono={preloadMono}
  preloadSerifItalic={preloadSerifItalic}
>
  <PostArticle post={post}>
    <Content />
  </PostArticle>
</Base>