---
// Homepage: all posts, newest first, card mode.
// Post URLs are /<slug>/ derived from content-collection filenames
// (see the benasher-co skill invariant — never title-slugify).
import Base from '../layouts/Base.astro';
import PostEntry from '../components/PostEntry.astro';
import { sortedPosts } from '../lib/posts';

const posts = await sortedPosts();
---

<Base pageTitle="Blog" path="/" type="website">
  <h1 class="sr-only">Blog</h1>
  {posts.map((post) => <PostEntry post={post} />)}
</Base>
