---
// Homepage: masthead statement, then every post as a ruled index row,
// grouped by year (newest first).
// Post URLs are /<slug>/ derived from content-collection filenames
// (see the benasher-co skill invariant — never title-slugify).
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { laYear } from '../lib/dates';
import { sortedPosts } from '../lib/posts';

const posts = await sortedPosts();

// group by site-local year, preserving the newest-first order
const years = [...new Set(posts.map((post) => laYear(post.data.pubDate)))];
const grouped = years.map((year) => ({
  year,
  posts: posts.filter((post) => laYear(post.data.pubDate) === year),
}));
---

<Base pageTitle="Blog" path="/" type="website">
  <section class="masthead">
    <p class="label">writing</p>
    <div>
      <h1>An archive.</h1>
      <p class="facts">
        {posts.length} posts · {years[years.length - 1]}–{years[0]}
      </p>
    </div>
  </section>

  {
    grouped.map(({ year, posts: yearPosts }) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <p class="y" id={`year-${year}`}>
          {year}
        </p>
        <ul>
          {yearPosts.map((post) => (
            <PostRow post={post} />
          ))}
        </ul>
      </section>
    ))
  }
</Base>
