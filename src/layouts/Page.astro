---
// Port of _layouts/page.html
import Base from './Base.astro';

interface Props {
  pageTitle: string;
  description?: string;
  path: string;
}

const { pageTitle, description, path } = Astro.props;
---

<Base pageTitle={pageTitle} description={description} path={path} type="website">
  <article>
    <slot />
  </article>
</Base>
