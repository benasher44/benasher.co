---
// Base layout: head, nav, footer, theme machinery.
// Pico CSS + brand tokens live in main.css; fonts are self-hosted via
// fontsource variable packages (content-hashed _astro/ assets).
import '../styles/main.css';
import Seo from '../components/Seo.astro';
import { formatShortDate } from '../lib/dates';
import { SITE_DESCRIPTION, MASTODON_URL, REPO_URL } from '../lib/site';

interface Props {
  pageTitle: string;
  description?: string;
  path: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { pageTitle, description, path, type, pubDate } = Astro.props;

const nav = [
  { title: 'Blog', href: '/' },
  { title: 'About', href: '/about/' },
];

const now = new Date(); // build time
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121514" />
    <Seo pageTitle={pageTitle} description={description} path={path} type={type} pubDate={pubDate} />
    <script is:inline>
      // set the theme before first paint — no flash.
      // ?theme=light|dark wins (shareable/previewable), then localStorage, then system.
      const qsTheme = new URLSearchParams(location.search).get('theme');
      const stored = localStorage.getItem('theme');
      if (qsTheme === 'light' || qsTheme === 'dark') {
        document.documentElement.dataset.theme = qsTheme;
      } else if (stored) {
        document.documentElement.dataset.theme = stored;
      } else if (matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <nav aria-label="Main">
        <a class="brand" href="/">benasher.co</a>
        <div class="nav-links">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
              >
                {item.title}
              </a>
            ))
          }
          <a href="/feed.xml">RSS</a>
        </div>
      </nav>
    </header>
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
      aria-pressed="false"
    >☾</button>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        © {now.getFullYear()}
        <a rel="me" href={MASTODON_URL}>Ben Asher</a> · <a href={REPO_URL}>source</a>
      </p>
      <p>This site was last updated on {formatShortDate(now)}.</p>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
      const apply = (t: string) => {
        btn.textContent = t === 'dark' ? '☀' : '☾';
        btn.setAttribute('aria-pressed', String(t === 'dark'));
      };
      apply(document.documentElement.dataset.theme ?? 'light');
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        apply(next);
      });
    </script>
  </body>
</html>
